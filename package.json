{
  "name": "deplens",
  "version": "0.1.0",
  "description": "Flag npm supply chain risks that npm audit misses, with an explanation for every finding",
  "keywords": [
    "npm",
    "supply-chain",
    "security",
    "lockfile",
    "typosquatting"
  ],
  "license": "MIT",
  "author": "seag11",
  "type": "module",
  "bin": {
    "deplens": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
